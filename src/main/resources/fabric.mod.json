{
	"schemaVersion": 1,
	"id": "triwasa",
	"version": "${version}",
	"name": "TriWasa",
	"description": "Litematica compatibility for FCA V2-Extra easy place, the FCA big ender chest terminal, optional Quick Shulker hand restocking, a client item pickup filter, and fixes for other client mods.",
	"icon": "assets/triwasa/icon.png",
	"authors": [
		"Frostor"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"top.frostor.triwasa.TriWasa"
		],
		"rei_client": [
			"top.frostor.triwasa.compat.rei.TriWasaReiClientPlugin"
		],
		"modmenu": [
			"top.frostor.triwasa.compat.modmenu.TriWasaModMenu"
		]
	},
	"mixins": [
		"triwasa.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabricloader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "${fabric_api_dependency}",
		"malilib": "${malilib_dependency}",
		"litematica": "${litematica_dependency}"
	},
	"suggests": {
		"frostors-carpet-addition": "*",
		"modmenu": "*",
		"roughlyenoughitems": "*",
		"quickshulker": "*"
	},
	"breaks": {
		"earlycompat": "*"
	}
}
