{
	"schemaVersion": 1,
	"id": "triwasa",
	"version": "${version}",
	"name": "TriWasa",
	"description": "Litematica compatibility for FCA V2-Extra easy place, plus optional fixes for other client mods.",
	"authors": [
		"Frostor"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"top.frostor.triwasa.TriWasa"
		]
	},
	"mixins": [
		"triwasa.mixins.json"
	],
	"depends": {
		"fabricloader": "${fabricloader_dependency}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "${fabric_api_dependency}",
		"malilib": "${malilib_dependency}",
		"litematica": "${litematica_dependency}"
	},
	"suggests": {
		"roughlyenoughitems": "*"
	},
	"breaks": {
		"earlycompat": "*"
	}
}
